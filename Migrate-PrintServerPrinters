$copyButton.Add_Click({
    [System.Windows.Forms.Clipboard]::SetText($global:logText)
    Write-Log "Log copied to clipboard" "Success"
})

$button.Add_Click({
    $openFileDialog = New-Object System.Windows.Forms.OpenFileDialog
    $openFileDialog.Filter = "CSV Files (*.csv)|*.csv"
    if($openFileDialog.ShowDialog() -eq 'OK') {
        Write-Log "Starting printer migration process" "Info"
        Write-Log "Loading CSV file: $($openFileDialog.FileName)" "Info"
        
        $printers = Import-Csv $openFileDialog.FileName
        $progressBar.Maximum = $printers.Count
        $progressBar.Value = 0

        # Get unique source and destination servers
        $sourceServers = $printers | Select-Object -ExpandProperty sourceserver -Unique
        $destServers = $printers | Select-Object -ExpandProperty dstserver -Unique

        # Pre-fetch all printer data
        $serverData = @{}
        foreach ($server in $sourceServers) {
            Write-Log "Pre-fetching data from source server: $server" "Info"
            $serverData[$server] = Get-AllPrinterData -ServerName $server
        }
        foreach ($server in $destServers) {
            if (-not $serverData[$server]) {
                Write-Log "Pre-fetching data from destination server: $server" "Info"
                $serverData[$server] = Get-AllPrinterData -ServerName $server
            }
        }

        foreach($printer in $printers) {
            try {
                Write-Log "Processing printer migration:" "Info"
                Write-Log "Source: $($printer.sourceserver)\$($printer.sourcename)" "Info"
                Write-Log "Target: $($printer.dstserver)\$($printer.targetname)" "Info"
                
                # Get source printer from cached data
                $sourcePrinter = $serverData[$printer.sourceserver].Printers | 
                    Where-Object { $_.Name -eq $printer.sourcename }
                
                if (-not $sourcePrinter) {
                    throw "Source printer not found"
                }
                
                # Get source port from cached data
                $sourcePort = $serverData[$printer.sourceserver].Ports | 
                    Where-Object { $_.Name -eq $sourcePrinter.PortName }
                
                # Get SNMP settings from cached data
                $sourceSNMP = $serverData[$printer.sourceserver].SNMPPorts | 
                    Where-Object { $_.Name -eq $sourcePort.Name }

                # Get advanced settings from source printer
                Write-Log "Getting advanced settings from source printer" "Info"
                $advancedSettings = Get-AdvancedPrinterSettings -ComputerName $printer.sourceserver -PrinterName $printer.sourcename

                Write-Log "Retrieved source configurations" "Success"
                if ($sourceSNMP.SNMPEnabled) {
                    Write-Log "SNMP Enabled: True" "Info"
                    Write-Log "SNMP Index: $($sourceSNMP.SNMPDeviceIndex)" "Info"
                    Write-Log "Community: $($sourceSNMP.Community)" "Info"
                }

                # Check if port exists in destination cached data
                $destPort = $serverData[$printer.dstserver].Ports | 
                    Where-Object { $_.Name -eq $sourcePort.Name }

                if (-not $destPort) {
                    Write-Log "Creating port $($sourcePort.Name) on destination server" "Info"
                    Add-PrinterPort -ComputerName $printer.dstserver -Name $sourcePort.Name -PrinterHostAddress $sourcePort.PrinterHostAddress
                    
                    if ($sourceSNMP.SNMPEnabled) {
                        Write-Log "Configuring SNMP settings on destination port" "Info"
                        Set-SNMPSettings -ComputerName $printer.dstserver `
                            -PortName $sourcePort.Name `
                            -SNMPEnabled $sourceSNMP.SNMPEnabled `
                            -SNMPDevIndex $sourceSNMP.SNMPDeviceIndex `
                            -CommunityName $sourceSNMP.Community
                    }
                }

                Write-Log "Creating printer with following settings:" "Info"
                Write-Log "Driver: $($sourcePrinter.DriverName)" "Info"
                Write-Log "Port: $($sourcePort.Name)" "Info"
                Write-Log "Location: $($sourcePrinter.Location)" "Info"

                Add-Printer -ComputerName $printer.dstserver -Name $printer.targetname `
                    -DriverName $sourcePrinter.DriverName `
                    -PortName $sourcePort.Name `
                    -Location $sourcePrinter.Location `
                    -Comment $sourcePrinter.Comment `
                    -Shared:$sourcePrinter.Shared `
                    -ShareName $sourcePrinter.ShareName

                # Wait for printer creation
                Start-Sleep -Seconds 2

                # Apply advanced settings
                if ($advancedSettings) {
                    Write-Log "Applying advanced settings to destination printer" "Info"
                    Set-AdvancedPrinterSettings -ComputerName $printer.dstserver -PrinterName $printer.targetname -Settings $advancedSettings
                }

                # Copy device settings
                Write-Log "Copying device settings" "Info"
                Copy-PrinterDeviceSettings -SourceServer $printer.sourceserver `
                                         -SourcePrinter $printer.sourcename `
                                         -DestServer $printer.dstserver `
                                         -DestPrinter $printer.targetname

                Write-Log "Successfully created printer $($printer.targetname)" "Success"
                $progressBar.Value++
            }
            catch {
                Write-Log "Failed processing $($printer.sourcename)" "Error"
                Write-Log "Error Details: $_" "Error"
            }
            Write-Log "----------------------------------------" "Info"
        }
        Write-Log "Migration process completed" "Success"
        Write-Log "Log file saved to: $logFile" "Success"
    }
})

Write-Log "Printer Migration Tool Started" "Info"
Write-Log "Log file will be saved to: $logFile" "Info"
$form.ShowDialog()
