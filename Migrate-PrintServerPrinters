Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing

$logFile = Join-Path $PSScriptRoot "PrinterMigration_$(Get-Date -Format 'yyyyMMdd_HHmmss').log"
$global:logText = ""

# Define colors for log entries
$colors = @{
    Success = "#4CAF50"  # Green
    Error = "#F44336"    # Red
    Info = "#2196F3"     # Blue
    Warning = "#FF9800"  # Orange
}

function Write-Log {
    param(
        [string]$Message,
        [string]$Type = "Info" # Success, Error, Info, Warning
    )
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $logMessage = "[$timestamp] $Message"
    $global:logText += "$logMessage`r`n"
    
    # Set color based on message type
    $color = switch($Type) {
        "Success" { $colors.Success }
        "Error" { $colors.Error }
        "Warning" { $colors.Warning }
        default { $colors.Info }
    }
    
    $gridView.Rows.Add($timestamp, $Type, $Message)
    $lastIndex = $gridView.Rows.Count - 1
    $gridView.Rows[$lastIndex].DefaultCellStyle.ForeColor = [System.Drawing.ColorTranslator]::FromHtml($color)
    $gridView.FirstDisplayedScrollingRowIndex = $lastIndex
    
    Add-Content -Path $logFile -Value $logMessage
}

# Function to pre-fetch all printer data from a server
function Get-AllPrinterData {
    param ($ServerName)
    
    try {
        Write-Log "Fetching all printer data from $ServerName" "Info"
        
        $data = @{
            Printers = Get-Printer -ComputerName $ServerName
            Ports = Get-PrinterPort -ComputerName $ServerName
            SNMPPorts = Get-WmiObject -Class "Win32_TCPIPPrinterPort" -Namespace "root\CIMV2" -ComputerName $ServerName
        }
        
        Write-Log "Retrieved $($data.Printers.Count) printers, $($data.Ports.Count) ports from $ServerName" "Success"
        return $data
    }
    catch {
        Write-Log "Failed to fetch data from $ServerName : $_" "Error"
        return $null
    }
}

# Function to set SNMP settings using WMI
function Set-SNMPSettings {
    param (
        $ComputerName,
        $PortName,
        $SNMPEnabled,
        $SNMPDevIndex,
        $CommunityName
    )
    try {
        $port = Get-WmiObject -Class "Win32_TCPIPPrinterPort" -Namespace "root\CIMV2" `
            -ComputerName $ComputerName | Where-Object { $_.Name -eq $PortName }
        
        if ($port) {
            Write-Log "Setting SNMP values for port $PortName" "Info"
            Write-Log "SNMP Enabled: $SNMPEnabled" "Info"
            Write-Log "SNMP Index: $SNMPDevIndex" "Info"
            Write-Log "Community: $CommunityName" "Info"

            $port.SNMPEnabled = $SNMPEnabled
            if ($SNMPEnabled) {
                $port.SNMPDeviceIndex = $SNMPDevIndex
                $port.Community = $CommunityName
            }
            $port.Put() | Out-Null
            Write-Log "SNMP settings updated successfully" "Success"
        }
    }
    catch {
        Write-Log "Failed to set SNMP settings: $_" "Error"
    }
}

# Function to get advanced printer settings
function Get-AdvancedPrinterSettings {
    param (
        $ComputerName,
        $PrinterName
    )
    try {
        $printer = Get-WmiObject -Class "Win32_Printer" -Namespace "root\CIMV2" `
            -ComputerName $ComputerName | Where-Object { $_.Name -eq $PrinterName }
        
        if ($printer) {
            return @{
                PrintSpooledDocumentsFirst = $printer.PrintSpooledDocumentsFirst
                KeepPrintedJobs = $printer.KeepPrintedJobs
                WorkOffline = $printer.WorkOffline
                EnableBIDI = $printer.EnableBIDI
                DoCompleteFirst = $printer.DoCompleteFirst
                EnableDevQueryPrint = $printer.EnableDevQueryPrint
                RawOnly = $printer.RawOnly
                Published = $printer.Published
                Queued = $printer.Queued
                Direct = $printer.Direct
                StartTime = $printer.StartTime
                UntilTime = $printer.UntilTime
                DefaultPriority = $printer.DefaultPriority
                Priority = $printer.Priority
                ScheduledPrintingSupported = $printer.ScheduledPrintingSupported
            }
        }
        return $null
    }
    catch {
        Write-Log "Failed to get advanced printer settings: $_" "Error"
        return $null
    }
}

# Function to set advanced printer settings
function Set-AdvancedPrinterSettings {
    param (
        $ComputerName,
        $PrinterName,
        $Settings
    )
    try {
        $printer = Get-WmiObject -Class "Win32_Printer" -Namespace "root\CIMV2" `
            -ComputerName $ComputerName | Where-Object { $_.Name -eq $PrinterName }
        
        if ($printer -and $Settings) {
            Write-Log "Setting advanced printer settings for $PrinterName" "Info"
            
            foreach ($property in $Settings.Keys) {
                if ($null -ne $Settings[$property]) {
                    $printer.$property = $Settings[$property]
                    Write-Log "$property : $($Settings[$property])" "Info"
                }
            }

            $printer.Put() | Out-Null
            Write-Log "Advanced printer settings updated successfully" "Success"
        }
    }
    catch {
        Write-Log "Failed to set advanced printer settings: $_" "Error"
    }
}

# Function to copy device settings using PrintUI
function Copy-PrinterDeviceSettings {
    param (
        $SourceServer,
        $SourcePrinter,
        $DestServer,
        $DestPrinter
    )
    try {
        Write-Log "Copying device settings using PrintUI" "Info"
        
        # Export source printer settings to a temporary file
        $tempFile = [System.IO.Path]::GetTempFileName()
        $arguments = "/Ss /n `"\\$SourceServer\$SourcePrinter`" /f `"$tempFile`""
        
        Start-Process "printui.dll" -ArgumentList $arguments -Wait
        
        # Import settings to destination printer
        $arguments = "/Sr /n `"\\$DestServer\$DestPrinter`" /f `"$tempFile`""
        Start-Process "printui.dll" -ArgumentList $arguments -Wait
        
        # Clean up temp file
        Remove-Item $tempFile -Force
        
        Write-Log "Device settings copied successfully" "Success"
    }
    catch {
        Write-Log "Failed to copy device settings: $_" "Error"
    }
}

